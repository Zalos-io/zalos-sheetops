# Pass the frozen baseline image ID built with scripts/benchmarks/Dockerfile.
# Context contains Desktop's scripts/, references/, and a candidate wheels/ directory.
ARG BASELINE_IMAGE
FROM ${BASELINE_IMAGE} AS base
RUN apt-get update \
    && apt-get install -y --no-install-recommends libreoffice-calc \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir \
    'polars==1.38.1' 'fastexcel==0.20.2' 'XlsxWriter==3.2.9'
COPY scripts /opt/skills/xlsx/scripts
COPY references /opt/skills/xlsx/references
FROM base AS candidate
COPY wheels /wheels
RUN python -m pip install --no-deps /wheels/*.whl && rm -rf /wheels
